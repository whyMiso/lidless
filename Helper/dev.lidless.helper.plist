<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.lidless.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/LidlessHelper</string>
	<key>MachServices</key>
	<dict>
		<key>dev.lidless.helper</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>dev.lidless.Lidless</string>
	</array>
	<!-- Run at boot so an interrupted session (crash/reboot) is restored from the state file
	     even before the app launches. -->
	<key>RunAtLoad</key>
	<true/>
	<!-- Relaunch immediately if the helper crashes; bootRestore() then puts settings back. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
